<ContentControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:controls="using:Aeterni.Tunnel.Desktop.Controls"
                x:Class="Aeterni.Tunnel.Desktop.Controls.StatCard">
    <!-- 统计卡封装：Label 小字 + Content 数值区（隐式子内容即 Content，模板内渲染） -->
    <ContentControl.Template>
        <ControlTemplate TargetType="controls:StatCard">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="{TemplateBinding Label}" />
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </StackPanel>
            </Border>
        </ControlTemplate>
    </ContentControl.Template>
</ContentControl>
