<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Aeterni.Tunnel.Desktop.Controls"
        x:Class="Aeterni.Tunnel.Desktop.Dialogs.ConnectionDialog"
        Title="连接设置" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent" Background="Transparent">
    <Border CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgBrush}">
    <Grid RowDefinitions="Auto,*">
        <controls:WindowTitleBar Grid.Row="0" />
        <Border Grid.Row="1" Classes="card" Margin="16,8,16,16">
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="titleBar" Width="3" Height="14" />
                <TextBlock x:Name="TitleText" Text="连接设置" Classes="cardTitle" />
            </StackPanel>

            <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Text="请填写 ATS 服务端信息（与服务端 server.toml 一致），保存后自动连接并写入 agent.toml。" />

            <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                <TextBlock Classes="fieldLabel" Text="服务端" VerticalAlignment="Center" />
                <TextBox x:Name="AddressBox" Grid.Column="1" PlaceholderText="ATS 地址，如 127.0.0.1 或 my-server.com" />

                <TextBlock Grid.Row="1" Classes="fieldLabel" Text="端口" VerticalAlignment="Center" />
                <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" PlaceholderText="与服务端 bindPort 一致" />

                <TextBlock Grid.Row="2" Classes="fieldLabel" Text="令牌" VerticalAlignment="Center" />
                <TextBox x:Name="TokenBox" Grid.Row="2" Grid.Column="1" PasswordChar="●" PlaceholderText="ATS token" />

                <CheckBox x:Name="TlsBox" Grid.Row="3" Grid.Column="1" Content="TLS 加密传输" FontSize="11" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="取消" x:Name="CancelBtn" />
                <Button Classes="primary" Content="保存并连接" x:Name="OkBtn" />
            </StackPanel>
        </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
