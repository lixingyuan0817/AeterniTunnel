<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Aeterni.Tunnel.Desktop.Controls"
        x:Class="Aeterni.Tunnel.Desktop.Dialogs.ConfirmDialog"
        Title="确认" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent" Background="Transparent">
    <Border CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgBrush}">
    <Grid RowDefinitions="Auto,*">
        <controls:WindowTitleBar Grid.Row="0" />
        <Border Grid.Row="1" Classes="card" Margin="16,8,16,16">
        <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="titleBar" Width="3" Height="14" Background="{DynamicResource YellowBrush}" />
                <TextBlock x:Name="TitleText" Text="确认" Classes="cardTitle" />
            </StackPanel>
            <TextBlock x:Name="MessageText" Text="" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="取消" x:Name="CancelBtn" />
                <Button Classes="primary" Content="确定" x:Name="OkBtn" Background="{DynamicResource RedBrush}" />
            </StackPanel>
        </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
