<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Aeterni.Tunnel.Desktop.Controls"
        x:Class="Aeterni.Tunnel.Desktop.Dialogs.TunnelEditorWindow"
        Title="隧道" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent" Background="Transparent">
    <Border CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgBrush}">
    <Grid RowDefinitions="Auto,*">
        <controls:WindowTitleBar Grid.Row="0" />
        <Border Grid.Row="1" Classes="card" Margin="16,8,16,16">
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="titleBar" Width="3" Height="14" />
                <TextBlock x:Name="TitleText" Text="添加隧道" Classes="cardTitle" />
            </StackPanel>

            <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                <TextBlock Classes="fieldLabel" Text="名称" VerticalAlignment="Center" />
                <TextBox x:Name="NameBox" Grid.Column="1" PlaceholderText="如 web" />

                <TextBlock Grid.Row="1" Classes="fieldLabel" Text="类型" VerticalAlignment="Center" />
                <ComboBox x:Name="TypeBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="tcp" />
                    <ComboBoxItem Content="udp" />
                    <ComboBoxItem Content="http" />
                    <ComboBoxItem Content="https" />
                </ComboBox>

                <TextBlock Grid.Row="2" Classes="fieldLabel" Text="本地地址" VerticalAlignment="Center" />
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,90" ColumnSpacing="8">
                    <TextBox x:Name="LocalIpBox" PlaceholderText="127.0.0.1" />
                    <TextBox x:Name="LocalPortBox" Grid.Column="1" PlaceholderText="端口" />
                </Grid>

                <TextBlock Grid.Row="3" Classes="fieldLabel" Text="公网端口" VerticalAlignment="Center" />
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="3">
                    <TextBox x:Name="RemotePortBox" PlaceholderText="tcp/udp 用；留空随机" />
                    <!-- 白名单前置校验提示（服务端 allowPorts 下发后即时校验） -->
                    <TextBlock x:Name="PortHint" Text="" Foreground="#F87171" FontSize="10" IsVisible="False" />
                </StackPanel>

                <TextBlock Grid.Row="4" Classes="fieldLabel" Text="域名" VerticalAlignment="Center" />
                <TextBox x:Name="DomainBox" Grid.Row="4" Grid.Column="1" PlaceholderText="http/https 用" />

                <TextBlock Grid.Row="5" Classes="fieldLabel" Text="分组" VerticalAlignment="Center" />
                <TextBox x:Name="GroupBox" Grid.Row="5" Grid.Column="1" PlaceholderText="留空 = default" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="取消" x:Name="CancelBtn" />
                <Button Classes="primary" Content="确定" x:Name="OkBtn" />
            </StackPanel>
        </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
