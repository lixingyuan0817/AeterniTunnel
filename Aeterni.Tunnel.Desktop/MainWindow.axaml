<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Aeterni.Tunnel.Desktop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="660"
        x:Class="Aeterni.Tunnel.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AETERNI TUNNEL · ATC"
        Width="1000" Height="660" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="AcrylicBlur,Blur" Background="{DynamicResource WindowBgBrush}">

    <Panel>
        <Grid x:Name="MainRoot" ColumnDefinitions="196,*">

            <!-- ═══ 左侧边栏：品牌 + 导航菜单 + 主题 + 状态 ═══ -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0"
                    Background="{DynamicResource BgBrush}">
                <Grid RowDefinitions="Auto,*,Auto" Margin="14,16">

                    <!-- 品牌 -->
                    <StackPanel Grid.Row="0" Spacing="2" Margin="8,0,8,16">
                        <TextBlock Text="AETERNI TUNNEL" FontWeight="Bold" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="ATC 客户端 · 内网穿透" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>

                    <!-- 导航菜单 -->
                    <StackPanel Grid.Row="1" Spacing="3">
                        <Button Classes="navItem" Content="🏠 首页" Command="{Binding NavigateHomeCommand}"
                                Foreground="{Binding NavHomeBrush}" Background="{Binding NavHomeBg}" />
                        <Button Classes="navItem" Content="🔗 隧道" Command="{Binding NavigateTunnelsCommand}"
                                Foreground="{Binding NavTunnelsBrush}" Background="{Binding NavTunnelsBg}"
                                IsEnabled="{Binding TunnelsNavEnabled}" />
                        <Button Classes="navItem" Content="🎮 开服" Command="{Binding NavigateLauncherCommand}"
                                Foreground="{Binding NavLauncherBrush}" Background="{Binding NavLauncherBg}" />
                        <Button Classes="navItem" Content="⚙ 设置" Command="{Binding NavigateSettingsCommand}"
                                Foreground="{Binding NavSettingsBrush}" Background="{Binding NavSettingsBg}" />
                    </StackPanel>

                    <!-- 底部：主题 + 连接状态 -->
                    <StackPanel Grid.Row="2" Spacing="10">
                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="3"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                <RadioButton Classes="seg" Content="☀" ToolTip.Tip="明亮" IsChecked="{Binding IsLightChecked}" />
                                <RadioButton Classes="seg" Content="🌙" ToolTip.Tip="黑暗" IsChecked="{Binding IsDarkChecked}" />
                                <RadioButton Classes="seg" Content="◐" ToolTip.Tip="跟随系统" IsChecked="{Binding IsSystemChecked}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="10,8">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding StatusBarText}" FontSize="11" Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 右侧内容区（页面切换：ViewLocator 按页面标记映射各 View） ═══ -->
            <Grid Grid.Column="1" Margin="20">
                <ContentControl Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>

        <!-- ═══ Toast 层（全局通知） ═══ -->
        <ItemsControl ItemsSource="{Binding Toasts}" Margin="0,16,16,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToastItemViewModel">
                    <Border Background="{DynamicResource ToastBgBrush}"
                            BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12,9" Margin="0,0,0,8"
                            BoxShadow="0 4 14 0 #40000000">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="4" CornerRadius="2" Background="{Binding Accent}"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12"
                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</Window>
