<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Aeterni.Tunnel.Desktop.Controls"
             xmlns:vm="using:Aeterni.Tunnel.Desktop.ViewModels"
             x:Class="Aeterni.Tunnel.Desktop.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">
    <!-- 设置页：连接设置表单 + 保存/加载 + 使用说明 -->
    <Grid ColumnDefinitions="440,*" ColumnSpacing="12">

        <controls:SectionCard Grid.Column="0" Title="连接设置" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <StackPanel Spacing="8">
                    <controls:FormField Label="服务端">
                        <TextBox Text="{Binding ServerAddr}" PlaceholderText="ATS 地址" />
                    </controls:FormField>
                    <controls:FormField Label="端口">
                        <TextBox Text="{Binding ServerPort}" PlaceholderText="7000" />
                    </controls:FormField>
                    <controls:FormField Label="令牌">
                        <TextBox Text="{Binding Token}" PasswordChar="●" PlaceholderText="ATS token" />
                    </controls:FormField>
                    <controls:FormField Label="客户端ID">
                        <TextBox Text="{Binding ClientId}" PlaceholderText="留空自动生成" />
                    </controls:FormField>
                    <!-- 与输入列（72 标签 + 8 间距）对齐 -->
                    <CheckBox Content="TLS 加密传输" IsChecked="{Binding UseTls}" FontSize="11" Margin="80,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="保存设置" Command="{Binding SaveSettingsCommand}" />
                    <Button Classes="ghost" Content="加载 agent.toml" Command="{Binding LoadConfigCommand}" />
                </StackPanel>

                <TextBlock Classes="fieldLabel" TextWrapping="Wrap"
                           Text="保存后写入 agent.toml，下次启动自动读取并自动连接；修改服务端参数后保存会自动重新连接。" />
            </StackPanel>
        </controls:SectionCard>

        <controls:SectionCard Grid.Column="1" Title="使用说明" VerticalAlignment="Top">
            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Text="1. 填写 ATS 服务端地址、端口与令牌（与服务端 server.toml 一致）。&#10;2. 点击「保存设置」写入 agent.toml，保存后自动连接。&#10;3. 客户端常连：启动读取配置自动连接，断线自动重连；重连期间隧道列表禁用。&#10;4. 隧道在「隧道」页统一管理；主题切换会一并保存，下次启动自动恢复。" />
        </controls:SectionCard>
    </Grid>
</UserControl>
