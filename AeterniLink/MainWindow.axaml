<aeterni:AeterniWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:AeterniLink.Controls"
        xmlns:aeterni="using:AeterniLink.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="660"
        x:Class="AeterniLink.MainWindow"
        Title="AETERNI LINK">

    <!-- AeterniLink 窗口壳：圆角毛玻璃根（外观由 AeterniWindow 基类提供）+ 自定义标题栏 + 顶栏 + 内容区 + 状态栏
         风格体系与 Aeterni.Tunnel.Desktop 统一（同一套主题资源与全局样式） -->
    <Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource WindowBgBrush}">
        <Panel>
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- ═══ 自定义标题栏（三平台统一，拖拽/双击/红绿灯由控件处理） ═══ -->
                <controls:AeterniTitleBar Grid.Row="0" />

                <!-- ═══ 顶栏：页面导航 + 主题（品牌已移入标题栏） ═══ -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="ghost" Background="Transparent" BorderThickness="0" Padding="10,6" Content="首页" />
                            <Button Classes="ghost" Background="Transparent" BorderThickness="0" Padding="10,6" Content="隧道" />
                            <Button Classes="ghost" Background="Transparent" BorderThickness="0" Padding="10,6" Content="设置" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Classes="seg" Content="☀" ToolTip.Tip="明亮" />
                                    <RadioButton Classes="seg" Content="🌙" ToolTip.Tip="黑暗" IsChecked="True" />
                                    <RadioButton Classes="seg" Content="◐" ToolTip.Tip="跟随系统" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ 内容区：组件示例展示 ═══ -->
                <ScrollViewer Grid.Row="2" Margin="16">
                    <StackPanel Spacing="12">

                        <controls:AeterniSectionCard Title="统计概览 · AeterniStatCard">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <controls:AeterniStatCard Label="隧道总数">
                                    <TextBlock Text="42" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                </controls:AeterniStatCard>
                                <controls:AeterniStatCard Label="连接状态">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="9" Height="9" Classes.pulse="True"
                                                 Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="运行中" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </controls:AeterniStatCard>
                                <controls:AeterniStatCard Label="实时速率">
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                        <Run Text="1.2" /><Run Text=" MB/s" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                    </TextBlock>
                                </controls:AeterniStatCard>
                            </Grid>
                        </controls:AeterniSectionCard>

                        <controls:AeterniSectionCard Title="表单 · AeterniFormField">
                            <StackPanel Spacing="12">
                                <controls:AeterniFormField Label="服务器地址">
                                    <TextBox PlaceholderText="play.aeterni.dev" />
                                </controls:AeterniFormField>
                                <controls:AeterniFormField Label="认证令牌">
                                    <TextBox PlaceholderText="输入令牌…" />
                                </controls:AeterniFormField>
                            </StackPanel>
                        </controls:AeterniSectionCard>

                        <controls:AeterniSectionCard Title="按钮与控件">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="主要操作" />
                                    <Button Classes="ghost" Content="次要操作" />
                                    <Button Classes="danger" Content="危险操作" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox Content="自动重连" IsChecked="True" VerticalAlignment="Center" />
                                    <ComboBox SelectedIndex="0" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Paper" />
                                        <ComboBoxItem Content="Vanilla" />
                                        <ComboBoxItem Content="Forge" />
                                    </ComboBox>
                                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <RadioButton Classes="seg" Content="☀" ToolTip.Tip="明亮" />
                                            <RadioButton Classes="seg" Content="🌙" ToolTip.Tip="黑暗" IsChecked="True" />
                                            <RadioButton Classes="seg" Content="◐" ToolTip.Tip="跟随系统" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="badge"><TextBlock Classes="badgeText" Text="绿色主题" Foreground="{DynamicResource AccentBrush}" /></Border>
                                    <Border Classes="badge"><TextBlock Classes="badgeText" Text="毛玻璃" /></Border>
                                    <Border Classes="badge"><TextBlock Classes="badgeText" Text="中等圆角" /></Border>
                                </StackPanel>
                            </StackPanel>
                        </controls:AeterniSectionCard>

                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ 状态栏 ═══ -->
                <Border Grid.Row="3" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Classes.pulse="True"
                                     Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="就绪" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="AeterniLink" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Panel>
    </Border>
</aeterni:AeterniWindow>
