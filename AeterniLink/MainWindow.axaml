<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:AeterniLink.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="660"
        x:Class="AeterniLink.MainWindow"
        Title="AETERNI LINK"
        Width="1000" Height="660" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent" Background="Transparent">

    <!-- AeterniLink 布局壳：圆角根（无边框窗口）+ 自定义标题栏 + 顶栏 + 内容区 + 状态栏
         风格体系与 Aeterni.Tunnel.Desktop 统一（同一套主题资源与全局样式） -->
    <Border CornerRadius="10" ClipToBounds="True" Background="{DynamicResource WindowBgBrush}">
        <Panel>
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- ═══ 自定义标题栏（三平台统一，拖拽/双击/红绿灯由控件处理） ═══ -->
                <controls:WindowTitleBar Grid.Row="0" />

                <!-- ═══ 顶栏：页面导航 + 主题（品牌已移入标题栏） ═══ -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="ghost" Background="Transparent" BorderThickness="0" Padding="10,6" Content="首页" />
                            <Button Classes="ghost" Background="Transparent" BorderThickness="0" Padding="10,6" Content="隧道" />
                            <Button Classes="ghost" Background="Transparent" BorderThickness="0" Padding="10,6" Content="设置" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Classes="seg" Content="☀" ToolTip.Tip="明亮" />
                                    <RadioButton Classes="seg" Content="🌙" ToolTip.Tip="黑暗" IsChecked="True" />
                                    <RadioButton Classes="seg" Content="◐" ToolTip.Tip="跟随系统" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ 内容区：常用组件演示 ═══ -->
                <ScrollViewer Grid.Row="2" Margin="16">
                    <StackPanel Spacing="12">

                        <controls:SectionCard Title="常用组件">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <controls:StatCard Label="模块数">
                                        <TextBlock Text="3" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                    </controls:StatCard>
                                    <controls:StatCard Label="状态">
                                        <TextBlock Text="运行中" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </controls:StatCard>
                                    <controls:StatCard Label="速率">
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}">
                                            <Run Text="0" /><Run Text=" KB/s" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                        </TextBlock>
                                    </controls:StatCard>
                                </Grid>
                            </StackPanel>
                        </controls:SectionCard>

                        <controls:SectionCard Title="表单与控件">
                            <StackPanel Spacing="12">
                                <controls:FormField Label="服务器地址">
                                    <TextBox PlaceholderText="play.aeterni.dev" />
                                </controls:FormField>
                                <controls:FormField Label="认证令牌">
                                    <TextBox PlaceholderText="输入令牌…" />
                                </controls:FormField>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="保存" />
                                    <Button Classes="ghost" Content="取消" />
                                    <Button Classes="danger" Content="重置" />
                                    <CheckBox Content="开机自动启动" IsChecked="True" VerticalAlignment="Center" />
                                    <ComboBox SelectedIndex="0" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Paper" />
                                        <ComboBoxItem Content="Vanilla" />
                                        <ComboBoxItem Content="Forge" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </controls:SectionCard>

                        <Border Classes="card">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="badge"><TextBlock Classes="badgeText" Text="风格统一" /></Border>
                                <TextBlock Classes="fieldLabel" Text="本页演示 AeterniLink 继承自 Aeterni.Tunnel.Desktop 的主题资源与组件封装。" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ 状态栏 ═══ -->
                <Border Grid.Row="3" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Classes.pulse="True"
                                     Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="就绪" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="AeterniLink" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Panel>
    </Border>
</Window>
