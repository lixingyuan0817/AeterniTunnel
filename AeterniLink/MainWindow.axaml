<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:AeterniLink.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="660"
        x:Class="AeterniLink.MainWindow"
        Title="AETERNI LINK"
        Width="1000" Height="660" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent" Background="Transparent">

    <!-- AeterniLink 布局壳：圆角根（无边框窗口）+ 自定义标题栏 + 顶栏 + 内容区 + 状态栏
         风格体系与 Aeterni.Tunnel.Desktop 统一（同一套主题资源与全局样式） -->
    <Border CornerRadius="10" ClipToBounds="True" Background="{DynamicResource WindowBgBrush}">
        <Panel>
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- ═══ 自定义标题栏（三平台统一，拖拽/双击/红绿灯由控件处理） ═══ -->
                <controls:WindowTitleBar Grid.Row="0" />

                <!-- ═══ 顶栏：页面导航 + 主题（品牌已移入标题栏） ═══ -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="ghost" Background="Transparent" BorderThickness="0" Padding="10,6" Content="首页" />
                            <Button Classes="ghost" Background="Transparent" BorderThickness="0" Padding="10,6" Content="隧道" />
                            <Button Classes="ghost" Background="Transparent" BorderThickness="0" Padding="10,6" Content="设置" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Classes="seg" Content="☀" ToolTip.Tip="明亮" />
                                    <RadioButton Classes="seg" Content="🌙" ToolTip.Tip="黑暗" IsChecked="True" />
                                    <RadioButton Classes="seg" Content="◐" ToolTip.Tip="跟随系统" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ 内容区：首页（空态欢迎页，模块页面后续接入） ═══ -->
                <Grid Grid.Row="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="AETERNI LINK" FontSize="30" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="内网穿透 · 游戏开服 · 联机房间" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                        <Border Classes="badge" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Classes="badgeText" Text="模块化客户端 · 功能陆续接入"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ═══ 状态栏 ═══ -->
                <Border Grid.Row="3" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Classes.pulse="True"
                                     Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="就绪" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="AeterniLink" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Panel>
    </Border>
</Window>
